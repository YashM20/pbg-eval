# pbg-backend staging (required — never point at prod without explicit opt-in)
PBG_BACKEND_URL=http://localhost:8000
PBG_BACKEND_EMAIL=eval@example.com
PBG_BACKEND_PASSWORD=

# Refuse non-staging URLs unless true
PBG_ALLOW_PROD=false

# OCR & Inference endpoints
paddleocr_endpoints="http://xx.xx.x.xx:8002"
ollama_endpoints="http://xx.xx.x.xx:11434"

# Gemini grader
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# SQLite storage
PBG_DB_PATH=data/pbg_eval.db

# Comparison polling (comparisons take 10–20 min/doc — poll generously)
PBG_POLL_INTERVAL=10
PBG_POLL_TIMEOUT=3600
PBG_UPLOAD_POLL_TIMEOUT=3600

# Per-request HTTP timeouts (seconds)
PBG_REQUEST_TIMEOUT=60
PBG_COMPARISON_TIMEOUT=300
PBG_S3_UPLOAD_TIMEOUT=300

# Transient network retry (backoff attempts on connect/read timeouts)
PBG_TRANSPORT_RETRIES=3
PBG_TRANSPORT_RETRY_DELAY=10

# Scope discipline penalty multiplier when score < 5 (default 0.85)
PBG_SCOPE_PENALTY=0.85
